# Kopieren nach /home/trader/connors-bot.env und anpassen. Keine Passwörter hier –
# die IBKR-Zugangsdaten gehören nur in die IBC-Konfiguration des IB Gateway.
CB_MAX_POSITIONS=5
CB_STOP_PCT=none
CB_MAX_DRAWDOWN=0.25
CB_CAPITAL_LIMIT_USD=
CB_IB_HOST=127.0.0.1
CB_IB_PORT=4002
CB_IB_CLIENT_ID=17
CB_MARKET_DATA_TYPE=1
CB_TELEGRAM_TOKEN=
CB_TELEGRAM_CHAT_ID=
# IB Gateway nur bei Bedarf starten (ca. 30 Min. vor US-Schluss) und danach beenden.
# Leer lassen, wenn das Gateway dauerhaft separat läuft (z. B. Linux-Server).
CB_GATEWAY_START_CMD=/opt/ibc/gatewaystartmacos.sh -inline
CB_GATEWAY_LEAD_MINUTES=10
